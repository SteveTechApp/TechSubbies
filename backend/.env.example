# Copy this file to .env and fill in real values before running the backend.

# Database runtime. SQLite remains the supported runtime during the PostgreSQL
# migration-readiness phase. Selecting postgres is intentionally blocked until
# the async repository adapter and staging migration are complete.
DATABASE_PROVIDER="sqlite"

# Where the local SQLite database file is stored (created automatically).
DB_FILE="./data/techsubbies.db"

# Future managed PostgreSQL connection string. Leave blank while using SQLite.
DATABASE_URL=""

# Optional destination for verified SQLite backups. Defaults to ./data/backups.
DB_BACKUP_DIR="./data/backups"

# Secret used to sign login tokens. Production startup requires at least
# 32 characters and rejects this placeholder.
JWT_SECRET="change-this-to-a-long-random-string"

# Optional: Google Gemini API key. If unset, the AI assistant endpoints
# will respond with a clear "not configured" error instead of crashing.
GEMINI_API_KEY=""

# Port the backend listens on.
PORT=4000

# Exact frontend origin used for credentialed CORS. Production requires HTTPS.
FRONTEND_ORIGIN="http://localhost:5173"

# Transactional account email. Development defaults to an in-memory outbox.
# Production startup requires Resend and a sender from a verified domain.
EMAIL_PROVIDER="development"
RESEND_API_KEY=""
EMAIL_FROM="TechSubbies <accounts@techsubbies.com>"
