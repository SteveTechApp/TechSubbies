# Copy this file to .env and fill in real values before running the backend.

# Where the local SQLite database file is stored (created automatically).
DB_FILE="./data/techsubbies.db"

# Secret used to sign login tokens. Production startup requires at least
# 32 characters and rejects this placeholder.
JWT_SECRET="change-this-to-a-long-random-string"

# Optional: Google Gemini API key. If unset, the AI assistant endpoints
# will respond with a clear "not configured" error instead of crashing.
GEMINI_API_KEY=""

# Port the backend listens on.
PORT=4000

# Exact frontend origin used for credentialed CORS. Production requires HTTPS.
FRONTEND_ORIGIN="http://localhost:5173"
