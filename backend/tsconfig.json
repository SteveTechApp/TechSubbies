{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": [
    "src/deployment.test.ts",
    "src/billing/stripeProvider.ts",
    "src/lib/accountEmail.ts",
    "src/lib/documentStorage.ts",
    "src/routes/documents.ts",
    "src/routes/documents.test.ts",
    "src/routes/marketplace.ts",
    "src/routes/marketplace.test.ts",
    "src/routes/membershipBilling.ts",
    "src/routes/membershipBilling.test.ts",
    "src/routes/trust.ts"
  ]
}
